AWS_ACCESS_KEY_ID = "aws_access_key_id"
AWS_SECRET_ACCESS_KEY_AD = "aws_secret_access_key"
AWS_REGION = "eu-north-1"
S3_BUCKET = "s3_bucket_name"

BEDROCK_EMBED_MODEL=amazon.titan-embed-text-v2:0
BEDROCK_CHAT_MODEL=amazon.nova-lite-v1:0
EMBED_DIM=1024

PINECONE_API_KEY = "pinecone_api_key"
PINECONE_INDEX_HOST = "atlas-index"
PINECONE_CLOUD=aws 
PINECONE_REGION=us-east-1
PINECONE_READY_TIMEOUT=180

DATABASE_URL = postgre_url
RIUS_API_KEY = "rius_api_key"
RIUS_SERVICE_NAME=atlas
RIUS_DISABLED=false
RIUS_CAPTURE_CONTENT=false
